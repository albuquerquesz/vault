{
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["vite/client", "vite-plugin-pwa/client"],
		"rootDirs": ["."],
		"paths": {
			"@/*": ["./src/*"],
			"@vault/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
