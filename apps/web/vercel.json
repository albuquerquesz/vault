{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"rewrites": [
		{
			"source": "/api/auth/(.*)",
			"destination": "https://vault-api-phi.vercel.app/api/auth/$1"
		},
		{
			"source": "/api/(.*)",
			"destination": "https://vault-api-phi.vercel.app/api/$1"
		},
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}
