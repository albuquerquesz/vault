# Local dev values. Prod (Cloudflare Worker) secrets live in apps/api/.env.production
# and are only uploaded with `bun run cf:deploy -- --sync-secrets`.
BETTER_AUTH_SECRET=change-me-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional 32-byte base64 key for encrypting user Pluggy secrets (BYOK)
# openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Web Push (optional; all three values are required to enable the feature).
# Generate a key pair with: bunx web-push generate-vapid-keys --json
# Keep the private key only on the API deployment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Public HTTPS webhook URL for Pluggy (production Vercel).
# Defaults to ${BETTER_AUTH_URL}/api/webhooks/pluggy
# PLUGGY_WEBHOOK_URL=https://your-api.vercel.app/api/webhooks/pluggy
# Optional shared secret for webhook registration + validation
# PLUGGY_WEBHOOK_SECRET=

# Optional Notifique transactional email for Better Auth password resets.
# Use a verified sender domain in NOTIFIQUE_FROM_EMAIL.
NOTIFIQUE_API_KEY=
NOTIFIQUE_BASE_URL=https://api.notifique.dev
NOTIFIQUE_FROM_EMAIL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=vault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5433/vault
