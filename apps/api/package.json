{
	"name": "api",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile api",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@fastify/cors": "^11.0.1",
		"@hono/trpc-server": "^0.4.0",
		"@trpc/server": "catalog:",
		"@vault/api": "workspace:*",
		"@vault/auth": "workspace:*",
		"@vault/db": "workspace:*",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"fastify": "^5.3.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@vault/config": "workspace:*",
		"tsdown": "^0.21.9",
		"typescript": "catalog:"
	}
}
