{
	"name": "api",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile api",
		"db:push": "bunx drizzle-kit push",
		"db:generate": "bunx drizzle-kit generate",
		"db:studio": "bunx drizzle-kit studio",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:seed": "bun run src/db/seed.ts",
		"pluggy:reingest": "bun run src/scripts/reingest-pluggy-expenses.ts",
		"db:start": "docker compose up -d",
		"db:watch": "docker compose up",
		"db:stop": "docker compose stop",
		"db:down": "docker compose down",
		"dev": "bun run src/index.ts",
		"dev:worker": "wrangler dev",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.3",
		"@neondatabase/serverless": "^1.1.0",
		"@notifique/sdk-node": "0.2.1",
		"@t3-oss/env-core": "^0.13.1",
		"better-auth": "catalog:",
		"dayjs": "^1.11.21",
		"dotenv": "^17.2.2",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.13.12",
		"pg": "^8.17.1",
		"web-push": "3.6.7",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260930.2",
		"@types/bun": "^1.3.4",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.16.0",
		"@types/web-push": "3.6.4",
		"drizzle-kit": "^0.31.8",
		"tsdown": "^0.21.9",
		"typescript": "^6.0.0"
	},
	"packageManager": "bun@1.3.10"
}
