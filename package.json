{
	"name": "vault",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/bun": "^1.3.4",
			"better-auth": "1.6.11",
			"next-themes": "^0.4.6",
			"react": "^19.2.6",
			"react-dom": "^19.2.6",
			"@types/react": "^19.2.15",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"build": "turbo --ui=stream build",
		"lint": "turbo --ui=stream lint",
		"check-types": "turbo --ui=stream check-types",
		"dev:web": "turbo --ui=stream -F web dev",
		"dev:api": "turbo --ui=stream -F api dev",
		"cf:deploy": "bun run scripts/cf-deploy.ts",
		"db:push": "turbo --ui=stream -F api db:push",
		"db:studio": "turbo --ui=stream -F api db:studio",
		"db:generate": "turbo --ui=stream -F api db:generate",
		"db:migrate": "turbo --ui=stream -F api db:migrate",
		"db:seed": "turbo --ui=stream -F api db:seed",
		"db:up": "turbo --ui=stream -F api db:start",
		"db:watch": "turbo --ui=stream -F api db:watch",
		"db:stop": "turbo --ui=stream -F api db:stop",
		"db:down": "turbo --ui=stream -F api db:down"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"dotenv": "catalog:",
		"pg": "^8.22.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@kubojs/cli": "0.2.2",
		"@types/bun": "catalog:",
		"@vault/config": "workspace:*",
		"turbo": "^2.8.12",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.10"
}
